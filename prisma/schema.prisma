generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id
  email        String      @unique
  name         String?
  phone        String?
  // Роль в системе (ЛР7): USER — обычный аутентифицированный участник,
  // ADMIN — доступны служебные страницы и методы API управления каталогом
  // (тренеры/абонементы/питание) и учётными записями других пользователей.
  // Копия роли, назначенной через UserRoles recipe SuperTokens (источник
  // истины при авторизации, см. src/auth/guards/roles.guard.ts) — здесь
  // хранится для удобных SQL-запросов/отображения в админ-панели.
  role         Role        @default(USER)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Связи
  membershipId String?
  membership   Membership? @relation(fields: [membershipId], references: [id])
  reviews      Review[]
  orders       Order[]
}

model Trainer {
  id             String   @id @default(uuid())
  name           String
  specialization String
  experience     Int      // Опыт в годах
  photoUrl       String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Membership {
  id          String   @id @default(uuid())
  name        String
  price       Decimal  @db.Decimal(10, 2)
  duration    Int      // Длительность в месяцах
  features    String[] // Список преимуществ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Связи
  users       User[]
}

model Review {
  id         String   @id @default(uuid())
  authorName String // Имя автора на момент публикации отзыва
  text       String
  rating     Int      @default(5)
  createdAt  DateTime @default(now())

  // Связи. Отзыв можно оставить и без учётной записи (гостевой отзыв),
  // поэтому связь с User необязательная.
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model Product {
  id          String   @id @default(uuid())
  name        String
  category    Category // Enum категория продуктов
  price       Decimal  @db.Decimal(10, 2)
  description String?
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Связи
  orderItems  OrderItem[]
}

model Order {
  id        String      @id @default(uuid())
  total     Decimal     @db.Decimal(10, 2)
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())

  // Связи
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(10, 2) // Фиксируем цену на момент покупки

  // Связи
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  
  @@unique([orderId, productId])
}

enum Role {
  USER
  ADMIN
}

enum Category {
  PROTEIN
  AMINO_ACIDS
  FAT_BURNERS
  VITAMINS
  ACCESSORIES
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  DELIVERED
}

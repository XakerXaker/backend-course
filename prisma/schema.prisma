generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String?
  phone        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  // Связи
  membershipId String?
  membership   Membership? @relation(fields: [membershipId], references: [id])
  reviews      Review[]
  orders       Order[]
}

model Trainer {
  id             String   @id @default(uuid())
  name           String
  specialization String
  experience     Int      // Опыт в годах
  photoUrl       String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Membership {
  id          String   @id @default(uuid())
  name        String
  price       Decimal  @db.Decimal(10, 2)
  duration    Int      // Длительность в месяцах
  features    String[] // Список преимуществ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Связи
  users       User[]
}

model Review {
  id        String   @id @default(uuid())
  text      String
  rating    Int      @default(5)
  createdAt DateTime @default(now())

  // Связи
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Product {
  id          String   @id @default(uuid())
  name        String
  category    Category // Enum категория продуктов
  price       Decimal  @db.Decimal(10, 2)
  description String?
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Связи
  orderItems  OrderItem[]
}

model Order {
  id        String      @id @default(uuid())
  total     Decimal     @db.Decimal(10, 2)
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())

  // Связи
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(10, 2) // Фиксируем цену на момент покупки

  // Связи
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  
  @@unique([orderId, productId])
}

enum Category {
  PROTEIN
  AMINO_ACIDS
  FAT_BURNERS
  VITAMINS
  ACCESSORIES
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  DELIVERED
}

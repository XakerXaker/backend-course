<main>
    <section id="trainers">
        <h2>Наша команда тренеров</h2>

        <div id="trainer-toast-zone" aria-live="polite" aria-atomic="true"></div>

        {{#if trainers.length}}
        <div class="trainer-grid" id="trainer-grid">
            {{#each trainers}}
            <article class="trainer-card" data-trainer-id="{{id}}">
                <h3>{{name}}</h3>
                <p><strong>Стаж:</strong> {{experience}} лет</p>
                <p><strong>Специализация:</strong> {{specialization}}</p>
                <p>{{bio}}</p>

                <div class="trainer-card-actions">
                    <a href="/trainers/{{id}}?auth={{../auth}}">Открыть</a>
                    <a href="/trainers/{{id}}/edit?auth={{../auth}}">Изменить</a>
                    <form method="post" action="/trainers/{{id}}/delete?auth={{../auth}}">
                        <button type="submit" class="delete-btn">Удалить</button>
                    </form>
                </div>
            </article>
            {{/each}}
        </div>
        {{else}}
        <p id="no-trainers-message">Пока нет тренеров. Добавьте первого через форму.</p>
        {{/if}}

        <div class="section-footer-actions">
            <a class="submit-btn section-add-btn" href="/trainers/add?auth={{auth}}">Добавить тренера</a>
        </div>
    </section>
</main>

<script src="/js/trainers-sse.js"></script>

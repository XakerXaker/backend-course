<main>
  <section id="register-form-section">
    <h2>Регистрация</h2>

    {{#if error}}
    <p class="form-error">{{error}}</p>
    {{/if}}

    <form class="simple-form" method="post" action="/register">
      <div class="form-group">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" value="{{email}}" required autofocus />
      </div>

      <div class="form-group">
        <label for="password">Пароль</label>
        <input id="password" name="password" type="password" minlength="6" required />
      </div>

      <div class="form-group">
        <label for="name">Имя</label>
        <input id="name" name="name" type="text" value="{{name}}" />
      </div>

      <div class="form-group">
        <label for="phone">Телефон</label>
        <input id="phone" name="phone" type="tel" value="{{phone}}" />
      </div>

      <button type="submit" class="submit-btn">Зарегистрироваться</button>
    </form>

    <p class="auth-switch-link">Уже есть аккаунт? <a href="/login">Войти</a></p>
  </section>
</main>

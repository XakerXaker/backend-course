<article class="trainer-card">
    {{#if photoUrl}}
    <img class="trainer-photo" src="{{photoUrl}}" alt="Фото тренера {{name}}" loading="lazy"
        onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
    <div class="trainer-photo trainer-photo-placeholder" style="display:none;" aria-hidden="true">{{initial name}}</div>
    {{else}}
    <div class="trainer-photo trainer-photo-placeholder" aria-hidden="true">{{initial name}}</div>
    {{/if}}
    <h3>{{name}}</h3>
    <p><strong>Стаж:</strong> {{experience}} лет</p>
    <p><em>Специализация:</em> {{specialization}}</p>
    <p>{{bio}}</p>
</article>

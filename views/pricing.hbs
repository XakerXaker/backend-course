<main>
    <section id="pricing">
        <h2>Тарифные планы</h2>
        <table>
            <thead>
                <tr>
                    <th>Тариф</th>
                    <th>Цена</th>
                    <th>Возможности</th>
                </tr>
            </thead>
            <tbody>
                {{#each pricing}}
                {{> pricing-row this}}
                {{/each}}
            </tbody>
        </table>
    </section>
</main>
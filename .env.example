# Строка подключения к PostgreSQL (Render/Aiven/локальный Postgres).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Порт приложения. Необязательно — на Render передаётся хостингом,
# локально по умолчанию используется 3000.
PORT=3000

# Yandex Object Storage (S3-совместимое объектное хранилище) — используется
# StorageService (src/storage) для загрузки фото тренеров, см. README.
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_REGION="ru-central1"
S3_BUCKET="powergit-gym"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Публичный базовый URL для отдачи загруженных файлов. Если не задан,
# StorageService соберёт его сам из S3_BUCKET (https://<bucket>.storage.yandexcloud.net).
S3_PUBLIC_URL_BASE="https://powergit-gym.storage.yandexcloud.net"

# Аутентификация (ЛР7) — конфигурация передаётся в AuthModule.register(...)
# при старте приложения, см. src/app.module.ts.
# Секрет для подписи JWT. На проде — длинная случайная строка
# (например, `openssl rand -hex 32`), в .env.example намеренно оставлена
# только заглушка "по умолчанию" (см. src/app.module.ts) для быстрого
# локального запуска без .env.
JWT_SECRET="change-me-to-a-long-random-string"
# Срок жизни токена в формате, понятном пакету jsonwebtoken (1d, 12h, 30m...).
JWT_EXPIRES_IN="1d"
# Имя httpOnly-cookie, в которой браузер хранит access-токен.
AUTH_COOKIE_NAME="access_token"
# Срок жизни той же cookie в миллисекундах (по умолчанию — сутки).
AUTH_COOKIE_MAX_AGE_MS=86400000
# Список разрешённых origin для CORS через запятую (см. main.ts). Если не
# задан — разрешены все origin (credentials-режим с отражением origin),
# что подходит для локальной разработки, но не для прода.
CORS_ORIGIN="http://localhost:3000"

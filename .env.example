# Строка подключения к PostgreSQL (Render/Aiven/локальный Postgres).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Порт приложения. Необязательно — на Render передаётся хостингом,
# локально по умолчанию используется 3000.
PORT=3000

# Yandex Object Storage (S3-совместимое объектное хранилище) — используется
# StorageService (src/storage) для загрузки фото тренеров, см. README.
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_REGION="ru-central1"
S3_BUCKET="powergit-gym"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Публичный базовый URL для отдачи загруженных файлов. Если не задан,
# StorageService соберёт его сам из S3_BUCKET (https://<bucket>.storage.yandexcloud.net).
S3_PUBLIC_URL_BASE="https://powergit-gym.storage.yandexcloud.net"

# Аутентификация (ЛР7) — провайдер SuperTokens. Конфигурация передаётся в
# AuthModule.forRoot(...) при старте приложения, см. src/app.module.ts.
# Connection URI и API-ключ — из личного кабинета supertokens.com
# (Managed Service, раздел Development/Production вашего проекта) либо
# адрес самостоятельно развёрнутого Core (self-hosted, см. документацию
# SuperTokens про Docker-образ supertokens/supertokens-postgresql).
SUPERTOKENS_CONNECTION_URI="https://try.supertokens.com"
SUPERTOKENS_API_KEY=""
# Название приложения — показывается в служебных email от SuperTokens
# (сброс пароля и т.п.).
APP_NAME="PowerGit Gym"
# Домен, на котором работает backend, и домен фронтенда — для этого
# приложения совпадают (Handlebars-страницы отдаёт тот же сервер).
API_DOMAIN="http://localhost:3000"
WEBSITE_DOMAIN="http://localhost:3000"
# Список разрешённых origin для CORS через запятую (см. main.ts). Если не
# задан — разрешены все origin (credentials-режим с отражением origin),
# что подходит для локальной разработки, но не для прода.
CORS_ORIGIN="http://localhost:3000"
